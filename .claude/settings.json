{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(git config --get:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",

      "Bash(gh auth status)",
      "Bash(gh extension list)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",

      "Bash(gh stack view:*)",
      "Bash(gh stack up:*)",
      "Bash(gh stack down:*)",
      "Bash(gh stack top:*)",
      "Bash(gh stack bottom:*)",
      "Bash(gh stack checkout:*)",

      "Bash(pnpm run:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm -F:*)",
      "Bash(pnpm --filter:*)",

      "Bash(node --version)",
      "Bash(which:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",

      "Read(./**)",
      "Edit(./**)",
      "Write(./**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push:* --force)",
      "Bash(git push:* -f)",
      "Bash(git reset --hard:*)",
      "Bash(git reset:* --hard)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -df:*)",
      "Bash(git clean -xf:*)",
      "Bash(git clean -xfd:*)",
      "Bash(git clean -fX:*)",
      "Bash(rm -rf:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm create:*)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(cat ~/.ssh:*)",
      "Bash(cat ~/.aws:*)",
      "Bash(ls ~/.ssh:*)",
      "Bash(ls ~/.aws:*)",
      "Bash(cp ~/.ssh:*)",
      "Bash(cp ~/.aws:*)",
      "Bash(mv ~/.ssh:*)",
      "Bash(mv ~/.aws:*)",
      "Bash(head ~/.ssh:*)",
      "Bash(head ~/.aws:*)",
      "Bash(tail ~/.ssh:*)",
      "Bash(tail ~/.aws:*)",
      "Bash(less ~/.ssh:*)",
      "Bash(less ~/.aws:*)",
      "Bash(more ~/.ssh:*)",
      "Bash(more ~/.aws:*)",
      "Bash(find ~/.ssh:*)",
      "Bash(find ~/.aws:*)",
      "Bash(scp ~/.ssh:*)",
      "Bash(scp ~/.aws:*)",
      "Bash(rsync ~/.ssh:*)",
      "Bash(rsync ~/.aws:*)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Write(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Edit(**/.aws/**)",
      "Write(**/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; cmd=json.load(sys.stdin).get('command',''); blocked=any(p in cmd for p in ['/.ssh','/.aws']); print('Blocked: command references a protected path (.ssh or .aws)') if blocked else None; sys.exit(2 if blocked else 0)\""
          }
        ]
      }
    ]
  }
}
